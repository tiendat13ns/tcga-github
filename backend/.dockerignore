# Thư mục môi trường ảo Python - không cần copy vào container
venv/

# Cache của Python
__pycache__/
*.pyc
*.pyo

# File môi trường chứa API key và mật khẩu - QUAN TRỌNG, không được copy!
# Dùng .env* để chặn cả .env.secret; chỉ giữ lại file mẫu.
.env*
!.env.example

# Log files
*.log

# Dữ liệu người dùng tải lên và file output tạm khi debug - không đóng vào image
uploads/
out.json
