DATABASE_URL=postgresql://postgres:password@host:5432/postgres
# --- OpenAI-compatible provider (e.g. Gemini via api.vilao.ai) ---
AI_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=https://api.vilao.ai/v1
OPENAI_COMPATIBLE_MODEL=ram/gemini-3.6-flash-high
OPENAI_COMPATIBLE_EMBEDDING_MODEL=dg/text-embedding-3-large
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=180

# Max cosine distance (0=identical, 2=opposite) for a retrieved chunk to be kept.
# Disabled by default (2.0 = no filtering) — baseline distance depends heavily on the
# embedding model/proxy in use. Check the "raw_distances" values in the backend logs
# for your own relevant vs irrelevant queries before enabling a lower value here.
RAG_MAX_COSINE_DISTANCE=2.0

# --- Supabase / Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
# BẮT BUỘC: secret HS256 dùng để xác minh chữ ký JWT. Không có giá trị mặc định — thiếu
# biến này backend sẽ không khởi động. Lấy ở Supabase Dashboard → Project Settings → API → JWT.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Danh sách email được cấp quyền admin, phân tách bằng dấu phẩy.
ADMIN_EMAILS=admin@example.com
